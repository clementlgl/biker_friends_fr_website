---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import SiteHeader from '../components/SiteHeader.astro';
import GearItem from '../components/GearItem.astro';
import MissionProgressBar from '../components/MissionProgressBar.astro';

const gearItems = (await getCollection('gear')).sort((a, b) => a.data.titre.localeCompare(b.data.titre));
const categories = ['All Gear', ...Array.from(new Set(gearItems.map((item) => item.data.categorie)))];
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Gear | Biker Friends</title>
    <style is:global>
      /* Checklist mode – checked item states */
      .gear-item.is-checked .checklist-view {
        border-color: rgba(0, 163, 196, 0.45) !important;
        background-color: rgba(0, 163, 196, 0.04) !important;
      }
      .gear-item.is-checked .checkbox-indicator {
        border-color: #00A3C4 !important;
        background-color: rgba(0, 163, 196, 0.18) !important;
      }
      .gear-item.is-checked .checkmark-icon {
        display: block !important;
      }
      .gear-item.is-checked .item-title-text {
        text-decoration: line-through;
        opacity: 0.45;
        color: #8b949e;
      }
    </style>
  </head>
  <body>
    <SiteHeader />
    <MissionProgressBar total={gearItems.length} />

    <main class="pb-16">
      <section class="relative overflow-hidden border-b border-tactical-line">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(0,163,196,0.15),transparent_42%),radial-gradient(circle_at_80%_0%,rgba(231,236,239,0.1),transparent_38%)]"></div>
        <div class="absolute inset-0 opacity-30 [background-size:4px_4px] [background-image:radial-gradient(rgba(255,255,255,0.08)_1px,transparent_1px)]"></div>
        <div class="relative mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
          <p class="font-tech text-xs uppercase tracking-[0.2em] text-tactical-muted">Essential Kit</p>
          <h1 class="mt-4 max-w-4xl font-display text-6xl leading-[0.88] text-tactical-text">GEAR ARCHIVE</h1>
          <p class="mt-6 max-w-3xl border-l-2 border-tactical-accent pl-4 font-tech text-sm leading-6 text-tactical-text">
            Curated technical equipment verified through thousands of miles in unforgiving terrain. This is the hardware that separates preparation from liability.
          </p>
        </div>
      </section>

      <section class="mx-auto mt-8 max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="border-y border-tactical-line py-4">
          <div class="flex flex-wrap items-center justify-between gap-4">
            <div id="gear-filters" class="flex flex-wrap gap-2" role="tablist" aria-label="Gear categories">
              {categories.map((category, index) => {
                const value = category === 'All Gear' ? 'all' : category;
                return (
                  <button
                    type="button"
                    class={`filter-btn border px-4 py-2 font-tech text-xs uppercase tracking-[0.14em] transition-colors ${
                      index === 0
                        ? 'border-tactical-accent bg-tactical-accent text-black'
                        : 'border-tactical-line text-tactical-text hover:border-tactical-accent hover:text-tactical-accentSoft'
                    }`}
                    data-filter={value}
                    aria-pressed={index === 0 ? 'true' : 'false'}
                  >
                    {category}
                  </button>
                );
              })}
            </div>

            <div class="flex shrink-0 items-center gap-2">
              <button
                id="toggle-mode-btn"
                type="button"
                class="flex items-center gap-2 border border-tactical-line px-4 py-2 font-tech text-xs uppercase tracking-[0.14em] text-tactical-muted transition-colors hover:border-tactical-accent hover:text-tactical-accentSoft"
                aria-pressed="false"
              >
                <svg class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 16 16" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <rect x="2" y="2" width="4.5" height="4.5" rx="0.5"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 4.5h5M9 8h5M9 11.5h5"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 7.5l1 1 2-2.5"/>
                </svg>
                <span>Checklist Mode</span>
              </button>
              <button
                id="reset-checklist-btn"
                type="button"
                class="hidden border border-tactical-line px-3 py-2 font-tech text-xs uppercase tracking-[0.14em] text-tactical-muted transition-colors hover:border-red-500/50 hover:text-red-400"
                title="Vider la checklist"
              >
                ↺ Reset
              </button>
            </div>
          </div>
        </div>

        <div id="gear-grid" class="mt-8 grid gap-8 md:grid-cols-2">
          {gearItems.map((item) => (
            <GearItem
              id={item.data.id}
              titre={item.data.titre}
              marque={item.data.marque}
              categorie={item.data.categorie}
              description={item.data.description}
              image={item.data.image}
              specs={item.data.specs}
            />
          ))}
        </div>
      </section>
    </main>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const STORAGE_KEY = 'bf-gear-checklist-v1';

        // ── State ────────────────────────────────────────────────────
        let isChecklistMode = false;
        let checkedItems = new Set(JSON.parse(localStorage.getItem(STORAGE_KEY) ?? '[]'));

        // ── DOM refs ─────────────────────────────────────────────────
        const filterButtons = Array.from(document.querySelectorAll('.filter-btn'));
        const gearCards     = Array.from(document.querySelectorAll('#gear-grid .gear-item'));
        const grid          = document.getElementById('gear-grid');
        const toggleModeBtn = document.getElementById('toggle-mode-btn');
        const resetBtn      = document.getElementById('reset-checklist-btn');

        // ── Icons ────────────────────────────────────────────────────
        const CHECKLIST_ICON = `<svg class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 16 16" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="2" y="2" width="4.5" height="4.5" rx="0.5"/><path stroke-linecap="round" stroke-linejoin="round" d="M9 4.5h5M9 8h5M9 11.5h5"/><path stroke-linecap="round" stroke-linejoin="round" d="M3 7.5l1 1 2-2.5"/></svg>`;
        const GALLERY_ICON   = `<svg class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 16 16" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="1" y="1" width="6" height="6" rx="0.5"/><rect x="9" y="1" width="6" height="6" rx="0.5"/><rect x="1" y="9" width="6" height="6" rx="0.5"/><rect x="9" y="9" width="6" height="6" rx="0.5"/></svg>`;

        // ── Filter ───────────────────────────────────────────────────
        const applyFilter = (filter) => {
          for (const card of gearCards) {
            const cat = card.getAttribute('data-category');
            card.classList.toggle('hidden', filter !== 'all' && cat !== filter);
          }
          for (const btn of filterButtons) {
            const active = btn.getAttribute('data-filter') === filter;
            btn.setAttribute('aria-pressed', String(active));
            btn.classList.toggle('border-tactical-accent', active);
            btn.classList.toggle('bg-tactical-accent', active);
            btn.classList.toggle('text-black', active);
            btn.classList.toggle('border-tactical-line', !active);
            btn.classList.toggle('text-tactical-text', !active);
          }
        };

        // ── Checklist ────────────────────────────────────────────────
        const saveChecked = () =>
          localStorage.setItem(STORAGE_KEY, JSON.stringify([...checkedItems]));

        const refreshCardVisual = (card) => {
          const id      = card.getAttribute('data-gear-id') ?? '';
          const checked = checkedItems.has(id);
          card.classList.toggle('is-checked', checked);
          const checklistView = card.querySelector('.checklist-view');
          if (checklistView) checklistView.setAttribute('aria-checked', String(checked));
        };

        const toggleItem = (id) => {
          checkedItems.has(id) ? checkedItems.delete(id) : checkedItems.add(id);
          saveChecked();
          const card = document.querySelector(`.gear-item[data-gear-id="${CSS.escape(id)}"]`);
          if (card) refreshCardVisual(card);
          window.dispatchEvent(new CustomEvent('gear:checklist-updated'));
        };

        // ── Mode switch ──────────────────────────────────────────────
        const setMode = (checklist) => {
          isChecklistMode = checklist;
          const progressBar = document.getElementById('mission-progress-bar');

          document.querySelectorAll('.gallery-view').forEach((el) => {
            el.style.display = checklist ? 'none' : '';
          });
          document.querySelectorAll('.checklist-view').forEach((el) => {
            el.style.display = checklist ? 'flex' : 'none';
          });

          if (checklist) {
            grid.classList.remove('grid', 'md:grid-cols-2', 'gap-8');
            grid.classList.add('flex', 'flex-col', 'gap-px');
            toggleModeBtn.innerHTML = `${GALLERY_ICON}<span>Gallery Mode</span>`;
            toggleModeBtn.classList.add('border-tactical-accent', 'text-tactical-accentSoft');
            toggleModeBtn.classList.remove('border-tactical-line', 'text-tactical-muted');
            resetBtn.classList.remove('hidden');
            if (progressBar) progressBar.classList.remove('hidden');
            gearCards.forEach(refreshCardVisual);
          } else {
            grid.classList.remove('flex', 'flex-col', 'gap-px');
            grid.classList.add('grid', 'md:grid-cols-2', 'gap-8');
            toggleModeBtn.innerHTML = `${CHECKLIST_ICON}<span>Checklist Mode</span>`;
            toggleModeBtn.classList.remove('border-tactical-accent', 'text-tactical-accentSoft');
            toggleModeBtn.classList.add('border-tactical-line', 'text-tactical-muted');
            resetBtn.classList.add('hidden');
            if (progressBar) progressBar.classList.add('hidden');
          }

          toggleModeBtn.setAttribute('aria-pressed', String(checklist));
        };

        // ── Events ───────────────────────────────────────────────────
        for (const btn of filterButtons) {
          btn.addEventListener('click', () => applyFilter(btn.getAttribute('data-filter') ?? 'all'));
        }

        toggleModeBtn.addEventListener('click', () => setMode(!isChecklistMode));

        resetBtn.addEventListener('click', () => {
          checkedItems.clear();
          saveChecked();
          gearCards.forEach(refreshCardVisual);
          window.dispatchEvent(new CustomEvent('gear:checklist-updated'));
        });

        for (const card of gearCards) {
          card.querySelector('.checklist-view')?.addEventListener('click', () => {
            toggleItem(card.getAttribute('data-gear-id') ?? '');
          });
          // Keyboard support
          card.querySelector('.checklist-view')?.addEventListener('keydown', (e) => {
            if (e.key === ' ' || e.key === 'Enter') {
              e.preventDefault();
              toggleItem(card.getAttribute('data-gear-id') ?? '');
            }
          });
        }

        // ── Init ─────────────────────────────────────────────────────
        applyFilter('all');
      });
    </script>
  </body>
</html>