---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MountainPassCard from '../components/MountainPassCard.astro';
import { getAllMountainPasses } from '../utils/mountainPasses';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

// Fetch all mountain passes
const allPasses = await getAllMountainPasses();

// Group passes by status for statistics
const stats = {
  total: allPasses.length,
  open: allPasses.filter(p => p.status === 'OPEN').length,
  closed: allPasses.filter(p => p.status === 'CLOSED').length,
  alert: allPasses.filter(p => p.status === 'ALERT' || p.status === 'PARTIAL').length,
};

// Extract unique countries and their massifs for two-level filter
type GeoEntry = { country: string; emoji: string; massifs: string[] };
const geoMap = new Map<string, GeoEntry>();
const countryEmojis: Record<string, string> = {
  France: '🇫🇷',
  Italie: '🇮🇹',
  Suisse: '🇨🇭',
  Autriche: '🇦🇹',
  Espagne: '🇪🇸',
  Allemagne: '🇩🇪',
  Andorre: '🇦🇩',
  Monaco: '🇲🇨',
  Slovénie: '🇸🇮',
};
for (const p of allPasses) {
  if (!p.country) continue;
  if (!geoMap.has(p.country)) {
    geoMap.set(p.country, { country: p.country, emoji: countryEmojis[p.country] || '', massifs: [] });
  }
  const entry = geoMap.get(p.country)!;
  if (p.massif && !entry.massifs.includes(p.massif)) {
    entry.massifs.push(p.massif);
  }
}
// Sort countries and their massifs alphabetically
const geoEntries: GeoEntry[] = Array.from(geoMap.values()).sort((a, b) => a.country.localeCompare(b.country));
geoEntries.forEach(e => e.massifs.sort((a, b) => a.localeCompare(b)));
---

<BaseLayout title="État des Cols | Biker Friends">
    <SiteHeader />

    <main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
      <!-- Header section -->
      <header class="mb-12">
        <h1 class="mt-3 font-display text-5xl leading-[0.9] text-tactical-text">État des Cols</h1>
        <p class="mt-4 max-w-3xl font-tech text-sm leading-6 text-tactical-muted">
          Conditions d'ouverture des cols.
        </p>
      </header>

      <!-- Stats section -->
      {allPasses.length > 0 && (
        <section class="mb-12 grid grid-cols-2 gap-4 md:grid-cols-4">
          <div class="border border-tactical-line rounded-lg bg-tactical-panel p-4">
            <p class="text-xs font-tech text-tactical-muted uppercase tracking-wider">Total</p>
            <p class="mt-2 font-display text-2xl text-tactical-text">{stats.total}</p>
          </div>
          <div class="border border-tactical-line rounded-lg bg-tactical-panel p-4">
            <p class="text-xs font-tech text-tactical-muted uppercase tracking-wider flex items-center gap-2">
              <span class="inline-block w-2 h-2 rounded-full" style="background-color: #00A3C4"></span>
              Ouverts
            </p>
            <p class="mt-2 font-display text-2xl text-tactical-text">{stats.open}</p>
          </div>
          <div class="border border-tactical-line rounded-lg bg-tactical-panel p-4">
            <p class="text-xs font-tech text-tactical-muted uppercase tracking-wider flex items-center gap-2">
              <span class="inline-block w-2 h-2 rounded-full" style="background-color: #F59E0B"></span>
              Alertes
            </p>
            <p class="mt-2 font-display text-2xl text-tactical-text">{stats.alert}</p>
          </div>
          <div class="border border-tactical-line rounded-lg bg-tactical-panel p-4">
            <p class="text-xs font-tech text-tactical-muted uppercase tracking-wider flex items-center gap-2">
              <span class="inline-block w-2 h-2 rounded-full" style="background-color: #EF4444"></span>
              Fermés
            </p>
            <p class="mt-2 font-display text-2xl text-tactical-text">{stats.closed}</p>
          </div>
        </section>
      )}

      <!-- View toggle buttons -->
      <section class="mb-8 flex justify-between items-center flex-wrap gap-3">
        <div class="flex items-center gap-2">
          <button 
            id="view-grid"
            class="px-3 py-2 bg-tactical-accent text-white font-tech text-xs uppercase font-semibold rounded transition-colors hover:opacity-90 flex items-center gap-2"
            title="Vue grille"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="7" height="7"></rect>
              <rect x="14" y="3" width="7" height="7"></rect>
              <rect x="14" y="14" width="7" height="7"></rect>
              <rect x="3" y="14" width="7" height="7"></rect>
            </svg>
            Grille
          </button>
          <button 
            id="view-map"
            class="px-3 py-2 border border-tactical-line text-tactical-text font-tech text-xs uppercase font-semibold rounded transition-colors hover:border-tactical-accent flex items-center gap-2"
            title="Vue carte"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            Carte
          </button>
        </div>

        <div class="flex items-center gap-2 px-3 py-2 border border-tactical-line rounded-lg bg-tactical-panel">
          <svg class="w-4 h-4 text-tactical-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.35-4.35"></path>
          </svg>
          <input 
            type="text" 
            placeholder="Rechercher un col..." 
            id="search-input"
            class="bg-transparent text-sm font-tech text-tactical-text placeholder-tactical-muted focus:outline-none"
          />
        </div>
      </section>

      <!-- Filters section — Géographie de l'Aventure -->
      <section class="mb-8 space-y-3">
        <!-- Level 1: Countries -->
        <div class="flex flex-wrap items-center gap-2">
          <button
            data-country="ALL"
            class="px-4 py-2 font-tech text-xs uppercase font-semibold rounded transition-colors bg-tactical-accent text-white"
          >
            Tous
          </button>
          {geoEntries.map(entry => (
            <button
              data-country={entry.country}
              class="px-4 py-2 font-tech text-xs uppercase font-semibold rounded transition-colors border border-tactical-line text-tactical-text hover:border-tactical-accent"
            >
                {entry.emoji} {entry.country}
            </button>
          ))}
        </div>

        <!-- Level 2: Massifs (hidden until a country is selected) -->
        <div id="massif-filters" class="hidden flex-wrap items-center gap-2">
          {geoEntries.map(entry => (
            <div data-massif-group={entry.country} class="hidden flex-wrap items-center gap-2">
              <button
                data-massif="ALL"
                class="px-3 py-1.5 font-tech text-xs uppercase font-semibold rounded transition-colors bg-tactical-accent/70 text-white"
              >
                Tous les massifs
              </button>
              {entry.massifs.map(massif => (
                <button
                  data-massif={massif}
                  class="px-3 py-1.5 font-tech text-xs uppercase font-semibold rounded transition-colors border border-tactical-line text-tactical-text hover:border-tactical-accent"
                >
                  {massif}
                </button>
              ))}
            </div>
          ))}
        </div>
      </section>

      <!-- Grid view container -->
      <section id="grid-view" class="grid gap-4" style="grid-template-columns: repeat(auto-fill, minmax(320px, 1fr))">
        {allPasses.length > 0 ? (
          allPasses.map((pass) => (
            <MountainPassCard pass={pass} />
          ))
        ) : (
          <div class="col-span-full border border-tactical-line rounded-lg bg-tactical-panel p-8 text-center">
            <p class="font-tech text-sm text-tactical-muted">
              Aucune donnée de cols disponible pour le moment. Les données seront actualisées régulièrement.
            </p>
          </div>
        )}
      </section>

      <!-- Map view container -->
      <section id="map-view" class="hidden">
        <div id="mountain-passes-map" class="w-full h-192 rounded-lg border border-tactical-line overflow-hidden bg-tactical-panel"></div>
      </section>

    </main>

    <SiteFooter />

    <script define:vars={{ passesDataStr: JSON.stringify(allPasses), basePath: base }}>
      // Initialize map with CDN
      let mapInitialized = false;
      const passesData = typeof passesDataStr === 'string' ? JSON.parse(passesDataStr) : passesDataStr;

      let mapMarkerSvg = null;
      let leafletMap = null;
      let markersLayer = null;

      const statusColors = {
        'OPEN': '#007a21',
        'CLOSED': '#EF4444',
        'ALERT': '#F59E0B',
        'PARTIAL': '#F59E0B'
      };

      async function initializeMap() {
        if (mapInitialized) return;
        mapInitialized = true;

        // Load Leaflet CSS if not already loaded
        if (!document.querySelector('link[href*="leaflet.css"]')) {
          const link = document.createElement('link');
          link.rel = 'stylesheet';
          link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
          document.head.appendChild(link);
        }

        // Preload map marker svg using base path
        const BASE = typeof basePath === 'string' ? basePath : '/';
        try {
          const resp = await fetch(BASE + 'images/map_marker.svg');
          if (resp.ok) mapMarkerSvg = await resp.text();
        } catch (e) {
          mapMarkerSvg = null;
        }
        console.log('map marker preload', { hasSvg: !!mapMarkerSvg, base: BASE });

        // Load Leaflet JS if not already loaded
        if (!window.L) {
          return new Promise(resolve => {
            const script = document.createElement('script');
            script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
            script.onload = () => {
              setupMap();
              resolve(null);
            };
            document.head.appendChild(script);
          });
        } else {
          setupMap();
        }
      }

      function setupMap() {
        const L = window.L;
        const mapElement = document.getElementById('mountain-passes-map');
        if (!mapElement || !L) return;

        leafletMap = L.map(mapElement).setView([45.5, 6.0], 8);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '© OpenStreetMap contributors',
          maxZoom: 19
        }).addTo(leafletMap);

        markersLayer = L.layerGroup().addTo(leafletMap);

        // Render initial markers for all passes
        renderMarkers(passesData);
      }

      function renderMarkers(filteredPasses) {
        if (!window.L || !leafletMap || !markersLayer) return;

        markersLayer.clearLayers();

        const coords = [];

        const BASE = typeof basePath === 'string' ? basePath : '/';

        filteredPasses.forEach((pass) => {
          if (!pass.coordinates) return;
          const [lat, lng] = pass.coordinates;
          const color = statusColors[pass.status] || '#8b949e';

          // Build marker HTML (recolor svg if available)
          let markerHtml = '';
          if (mapMarkerSvg) {
            const colored = mapMarkerSvg.replace(/fill=\"[^\"]*\"/g, `fill=\"${color}\"`).replace(/<svg/, '<svg style="width:26px;height:26px;">');
            markerHtml = `<div style="display:flex;align-items:center;justify-content:center;width:32px;height:32px;">${colored}</div>`;
          } else {
            markerHtml = '<div style="display:flex;align-items:center;justify-content:center;width:32px;height:32px;">' +
              '<img src="' + BASE + 'images/map_marker.svg" alt="marker" style="width:26px;height:26px;display:block;filter:drop-shadow(0 2px 4px rgba(0,0,0,0.35));" />' +
              '</div>';
          }

          const marker = window.L.marker([lat, lng], {
            icon: window.L.divIcon({
              html: markerHtml,
              iconSize: [32, 32],
              className: 'leaflet-marker'
            })
          });

          marker.bindPopup(`
            <div style="font-size: 12px;">
              <p style="font-weight: bold; margin: 0 0 4px 0;">${pass.name}</p>
              <p style="color: #666; margin: 0 0 4px 0;">${pass.altitude}m</p>
              <p style="font-weight: bold; margin: 0; color: ${color}">${pass.status}</p>
            </div>
          `);

          markersLayer.addLayer(marker);

          coords.push(pass.coordinates);
        });

        // Fit to bounds of filtered markers
        if (coords.length > 0) {
          const bounds = window.L.latLngBounds(coords);
          leafletMap.fitBounds(bounds, { padding: [50, 50] });
        }
      }

      // View toggle
      document.getElementById('view-grid').addEventListener('click', () => {
        document.getElementById('grid-view').classList.remove('hidden');
        document.getElementById('map-view').classList.add('hidden');
        document.getElementById('view-grid').classList.add('bg-tactical-accent', 'text-white');
        document.getElementById('view-grid').classList.remove('border', 'border-tactical-line', 'text-tactical-text');
        document.getElementById('view-map').classList.remove('bg-tactical-accent', 'text-white');
        document.getElementById('view-map').classList.add('border', 'border-tactical-line', 'text-tactical-text');
      });

      document.getElementById('view-map').addEventListener('click', () => {
        document.getElementById('grid-view').classList.add('hidden');
        document.getElementById('map-view').classList.remove('hidden');
        document.getElementById('view-map').classList.add('bg-tactical-accent', 'text-white');
        document.getElementById('view-map').classList.remove('border', 'border-tactical-line', 'text-tactical-text');
        document.getElementById('view-grid').classList.remove('bg-tactical-accent', 'text-white');
        document.getElementById('view-grid').classList.add('border', 'border-tactical-line', 'text-tactical-text');

        // Initialize map when view is shown
        setTimeout(initializeMap, 100);
      });

      // Update last update time (guarded in case element is not present)
      const now = new Date();
      const lastUpdateEl = document.getElementById('last-update');
      if (lastUpdateEl) {
        lastUpdateEl.textContent = now.toLocaleTimeString('fr-FR', {
          hour: '2-digit',
          minute: '2-digit'
        });
      }

      // Filter passes by search + country + massif
      const searchInput = document.getElementById('search-input');
      const passes = Array.from(document.querySelectorAll('[data-pass-name]'));

      let currentCountry = 'ALL';
      let currentMassif = 'ALL';
      let currentQuery = '';

      function applyFilters() {
        const normalizedQuery = currentQuery.trim().toLowerCase();
        passes.forEach(passEl => {
          const name = passEl.getAttribute('data-pass-name')?.toLowerCase() || '';
          const country = passEl.getAttribute('data-pass-country') || '';
          const massif = passEl.getAttribute('data-pass-massif') || '';
          const matchesQuery = normalizedQuery === '' || name.includes(normalizedQuery);
          const matchesCountry = currentCountry === 'ALL' || country === currentCountry;
          const matchesMassif = currentMassif === 'ALL' || massif === currentMassif;
          passEl.style.display = (matchesQuery && matchesCountry && matchesMassif) ? '' : 'none';
        });

        // Update map markers if map initialized
        if (mapInitialized) {
          const filteredForMap = passesData.filter(pass => {
            const matchesQuery = currentQuery.trim() === '' || pass.name.toLowerCase().includes(currentQuery.trim().toLowerCase());
            const matchesCountry = currentCountry === 'ALL' || (pass.country || '') === currentCountry;
            const matchesMassif = currentMassif === 'ALL' || (pass.massif || '') === currentMassif;
            return matchesQuery && matchesCountry && matchesMassif;
          });
          renderMarkers(filteredForMap);
        }
      }

      searchInput?.addEventListener('input', (e) => {
        currentQuery = (e.target).value || '';
        applyFilters();
      });

      // ── Country filter (Level 1) ──────────────────────────────────────────
      const countryButtons = Array.from(document.querySelectorAll('[data-country]'));
      const massifFiltersSection = document.getElementById('massif-filters');

      function activateCountryButton(btn) {
        countryButtons.forEach(b => {
          b.classList.remove('bg-tactical-accent', 'text-white');
          b.classList.add('border', 'border-tactical-line', 'text-tactical-text');
        });
        btn.classList.add('bg-tactical-accent', 'text-white');
        btn.classList.remove('border', 'border-tactical-line', 'text-tactical-text');
      }

      countryButtons.forEach(button => {
        button.addEventListener('click', () => {
          const selected = button.getAttribute('data-country') || 'ALL';
          currentCountry = selected;
          currentMassif = 'ALL';

          activateCountryButton(button);

          // Show/hide massif sub-filters
          if (selected === 'ALL') {
            massifFiltersSection?.classList.add('hidden');
            massifFiltersSection?.classList.remove('flex');
            // Hide all massif groups
            document.querySelectorAll('[data-massif-group]').forEach(g => {
              g.classList.add('hidden');
              g.classList.remove('flex');
            });
          } else {
            massifFiltersSection?.classList.remove('hidden');
            massifFiltersSection?.classList.add('flex');
            // Show only the matching group, hide others
            document.querySelectorAll('[data-massif-group]').forEach(g => {
              if (g.getAttribute('data-massif-group') === selected) {
                g.classList.remove('hidden');
                g.classList.add('flex');
              } else {
                g.classList.add('hidden');
                g.classList.remove('flex');
              }
            });
            // Reset massif buttons to default
            document.querySelectorAll('[data-massif]').forEach(b => {
              b.classList.remove('bg-tactical-accent', 'text-white');
              b.classList.add('border', 'border-tactical-line', 'text-tactical-text');
            });
            // Activate "Tous les massifs" button in the shown group
            const allMassifBtn = document.querySelector(`[data-massif-group="${selected}"] [data-massif="ALL"]`);
            if (allMassifBtn) {
              allMassifBtn.classList.add('bg-tactical-accent', 'text-white');
              allMassifBtn.classList.remove('border', 'border-tactical-line', 'text-tactical-text');
            }
          }

          applyFilters();
        });
      });

      // ── Massif filter (Level 2) ───────────────────────────────────────────
      document.addEventListener('click', (e) => {
        const target = e.target;
        if (!target || !target.hasAttribute || !target.hasAttribute('data-massif')) return;
        const selected = target.getAttribute('data-massif') || 'ALL';
        currentMassif = selected;

        // Update massif button styles within same group
        const group = target.closest('[data-massif-group]');
        if (group) {
          group.querySelectorAll('[data-massif]').forEach(b => {
            b.classList.remove('bg-tactical-accent', 'text-white');
            b.classList.add('border', 'border-tactical-line', 'text-tactical-text');
          });
          target.classList.add('bg-tactical-accent', 'text-white');
          target.classList.remove('border', 'border-tactical-line', 'text-tactical-text');
        }

        applyFilters();
      });
    </script>
</BaseLayout>
