---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import WorldMap from '../components/WorldMap.astro';
import { INLINE_INIT_SCRIPT } from '../scripts/theme';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

// Fetch all voyages
const voyages = await getCollection('voyages');

---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="icon" href={`${base}favicon.ico`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Biker Friends - Accueil</title>
		<!-- Script inline pour initialiser le thème sans flash -->
		<script is:inline set:html={INLINE_INIT_SCRIPT}></script>
	</head>
	<body class="bg-tactical-bg text-slate-100 overflow-x-hidden">
		<!-- Overlay Grain/Bruit -->
		<div class="fixed inset-0 pointer-events-none opacity-[0.015] z-0" 
			style="background-image: url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjAwIiBoZWlnaHQ9IjIwMCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48ZmlsdGVyIGlkPSJub2lzZSI+PGZlUGVydGluTm9pc2UgdHlwZT0iZnJhY3RhbE5vaXNlIiBiYXNlRnJlcXVlbmN5PSIwLjkiIG51bU9jdGF2ZXM9IjQiIHNlZWQ9IjIiIC8+PC9maWx0ZXI+PC9zdmc+'); background-size: 200px 200px;"></div>

		<SiteHeader />

		<main class="relative z-10">
			<!-- SECTION 01 : HERO CINÉMATIQUE -->
			<section class="w-full flex justify-center">
				<div class="w-full max-w-7xl px-6 mt-8 md:mt-12">
					<div class="relative mx-auto aspect-video md:v-[100vh] rounded-[2.5rem] overflow-hidden border border-white/10 group">
						<!-- Image de fond avec dégradé -->
						<div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent z-10"></div>
						<img
							src={`${base}images/CLA00867.jpg`}
							alt="Photo d'aventure à moto"
							class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
						/>

						<!-- Contenu Hero -->
						<div class="absolute inset-0 flex flex-col items-center justify-end z-20 pb-8 md:pb-16 px-6">
							<h1 class="font-display text-4xl md:text-7xl uppercase tracking-[0.08em] text-center leading-tight max-w-4xl mb-4 md:mb-6">
								
							</h1>
							<p class="font-tech text-sm md:text-base text-slate-300 text-center max-w-2xl mb-8 md:mb-12">
								
							</p>
							<!-- Boutons d'action -->
							<div class="flex flex-col sm:flex-row gap-4 items-center">
								<a href={`${base.replace(/\/$/, '')}/road-trips`} class="px-8 py-3 md:px-10 md:py-4 bg-tactical-accent hover:bg-[#0086b3] text-slate-950 font-tech font-semibold rounded-xl transition-all duration-300 hover:shadow-[0_0_30px_rgba(0,163,196,0.4)] uppercase text-sm md:text-base tracking-wide">
									Road Trips
									<span class="ml-2">→</span>
								</a>
								<a href={`${base.replace(/\/$/, '')}/gear`} class="px-8 py-3 md:px-10 md:py-4 border border-white/30 hover:border-tactical-accent text-white font-tech font-semibold rounded-xl transition-all duration-300 hover:bg-white/5 backdrop-blur-sm uppercase text-sm md:text-base tracking-wide">
									Matériel
									<span class="ml-2">✦</span>
								</a>
							</div>
						</div>
					</div>
				</div>
			</section>

		<!-- SECTION FOOTER -->
		<section class="w-full flex justify-center">
				<SiteFooter />
		</main>

		<!-- Animations & Intersection Observer -->
		<style>
			@keyframes fadeInUp {
				from {
					opacity: 0;
					transform: translateY(30px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			.fade-in-on-scroll {
				opacity: 0;
				animation: fadeInUp 0.6s ease-out forwards;
				animation-timeline: view();
				animation-range: entry 0% cover 30%;
			}

			/* Smooth scroll behavior */
			html {
				scroll-behavior: smooth;
			}
		</style>
		</script>
	</body>
</html>
