---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Biker Friends - Contact" bodyClass="bg-tactical-bg text-slate-100">
  <!-- Overlay Grain/Bruit -->
  <div class="fixed inset-0 pointer-events-none opacity-[0.015] z-0" 
    style="background-image: url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjAwIiBoZWlnaHQ9IjIwMCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48ZmlsdGVyIGlkPSJub2lzZSI+PGZlUGVydGluTm9pc2UgdHlwZT0iZnJhY3RhbE5vaXNlIiBiYXNlRnJlcXVlbmN5PSIwLjkiIG51bU9jdGF2ZXM9IjQiIHNlZWQ9IjIiIC8+PC9maWx0ZXI+PC9zdmc+'); background-size: 200px 200px;"></div>

  <SiteHeader />

  <main class="relative z-10">
    <section class="w-full flex justify-center py-16 md:py-24">
      <div class="w-full max-w-2xl mx-auto px-4 sm:px-6">
        <!-- Header -->
        <div class="mb-12">
          <h1 class="font-display text-4xl md:text-5xl uppercase tracking-[0.08em] text-tactical-accent mb-4">
            Nous Contacter
          </h1>
          <p class="font-tech text-sm md:text-base text-slate-300 max-w-xl">
            Vous avez une question ou une suggestion ?
          </p>
        </div>

        <!-- Form Container -->
        <div class="bg-tactical-panel/40 border border-tactical-line rounded-lg p-8 md:p-10">
          <!-- Success Message -->
          <div data-fs-success class="hidden mb-6 p-4 bg-green-900/30 border border-green-700 rounded-lg text-green-100">
            <p class="font-tech text-base">Merci ! Votre message a bien été envoyé. Nous vous répondrons bientôt.</p>
          </div>

          <!-- Error Message -->
          <div data-fs-error class="hidden mb-6 p-4 bg-red-900/30 border border-red-700 rounded-lg text-red-100">
            <p class="font-tech text-base">Erreur lors de l'envoi du message. Veuillez réessayer.</p>
          </div>

          <!-- Contact Form -->
          <form id="contact-form" action="https://formspree.io/f/xvzlldyr" method="POST">
            <!-- Name Field -->
            <div class="mb-6">
              <label for="name" class="block font-display text-sm uppercase tracking-[0.06em] text-slate-200 mb-2">
                Nom
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                data-fs-field
                class="w-full px-4 py-3 bg-tactical-bg/60 border border-tactical-line text-slate-100 placeholder-slate-500 rounded-lg focus:outline-none focus:border-tactical-accent focus:ring-1 focus:ring-tactical-accent transition-colors"
                placeholder="Votre nom"
              />
              <span data-fs-error="name" class="block text-red-400 text-sm mt-1 font-tech"></span>
            </div>

            <!-- Email Field -->
            <div class="mb-6">
              <label for="email" class="block font-display text-sm uppercase tracking-[0.06em] text-slate-200 mb-2">
                Email <span class="text-slate-400 text-xs font-tech">(optionnel)</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                data-fs-field
                class="w-full px-4 py-3 bg-tactical-bg/60 border border-tactical-line text-slate-100 placeholder-slate-500 rounded-lg focus:outline-none focus:border-tactical-accent focus:ring-1 focus:ring-tactical-accent transition-colors"
                placeholder="votre@email.com (optionnel)"
              />
              <span data-fs-error="email" class="block text-red-400 text-sm mt-1 font-tech"></span>
            </div>

            <!-- Subject Field -->
            <div class="mb-6">
              <label for="subject" class="block font-display text-sm uppercase tracking-[0.06em] text-slate-200 mb-2">
                Sujet
              </label>
              <input
                type="text"
                id="subject"
                name="subject"
                required
                data-fs-field
                class="w-full px-4 py-3 bg-tactical-bg/60 border border-tactical-line text-slate-100 placeholder-slate-500 rounded-lg focus:outline-none focus:border-tactical-accent focus:ring-1 focus:ring-tactical-accent transition-colors"
                placeholder="Sujet de votre message"
              />
              <span data-fs-error="subject" class="block text-red-400 text-sm mt-1 font-tech"></span>
            </div>

            <!-- Message Field -->
            <div class="mb-8">
              <label for="message" class="block font-display text-sm uppercase tracking-[0.06em] text-slate-200 mb-2">
                Message
              </label>
              <textarea
                id="message"
                name="message"
                required
                data-fs-field
                rows="6"
                class="w-full px-4 py-3 bg-tactical-bg/60 border border-tactical-line text-slate-100 placeholder-slate-500 rounded-lg focus:outline-none focus:border-tactical-accent focus:ring-1 focus:ring-tactical-accent transition-colors resize-none"
                placeholder="Votre message ici..."
              ></textarea>
              <span data-fs-error="message" class="block text-red-400 text-sm mt-1 font-tech"></span>
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              data-fs-submit-btn
              class="w-full px-8 py-4 bg-tactical-accent hover:bg-[#0086b3] text-slate-950 font-tech font-semibold rounded-lg transition-all duration-300 hover:shadow-[0_0_30px_rgba(0,163,196,0.4)] uppercase text-base tracking-wide disabled:opacity-50 disabled:cursor-not-allowed"
            >
              Envoyer le Message
            </button>
          </form>
        </div>

        <!-- Alternative Contact Info -->
        <div class="mt-12 pt-12 border-t border-tactical-line/30">
          <p class="font-tech text-sm text-slate-400 text-center">
            Vous préférez un autre moyen de nous contacter ? Envoyer un email à <a href="mailto:bikerfriendsfr@gmail.com" class="text-tactical-accent hover:underline">bikerfriendsfr@gmail.com</a>.
          </p>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contact-form');
    const successEl = document.querySelector('[data-fs-success]');
    const errorEl = document.querySelector('[data-fs-error]');
    const submitBtn = form.querySelector('[data-fs-submit-btn]');

    function clearFieldErrors() {
      form.querySelectorAll('[data-fs-error]').forEach((el) => { el.textContent = ''; });
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearFieldErrors();
      successEl.classList.add('hidden');
      errorEl.classList.add('hidden');
      submitBtn.disabled = true;

      const formData = new FormData(form);

      try {
        const res = await fetch(form.action, {
          method: form.method || 'POST',
          headers: { 'Accept': 'application/json' },
          body: formData,
        });

        const data = await res.json().catch(() => ({}));

        if (res.ok && data.ok) {
          // Show success message and do NOT redirect (we ignore data.next)
          successEl.classList.remove('hidden');
          errorEl.classList.add('hidden');
          form.reset();
        } else {
          // Field-level errors
          if (data && Array.isArray(data.errors) && data.errors.length) {
            data.errors.forEach((err) => {
              if (err.field) {
                const fld = form.querySelector(`[data-fs-error="${err.field}"]`);
                if (fld) fld.textContent = err.message || err.error || 'Erreur';
              }
            });
          } else {
            errorEl.classList.remove('hidden');
          }
        }
      } catch (err) {
        errorEl.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
      }
    });
  });
</script>
