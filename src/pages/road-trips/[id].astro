---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import GpxMap from '../../components/GpxMap.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { distanceFromGpx } from '../../utils/gpxDistance';
import { withBase } from '../../utils/withBase';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { ImageMetadata } from 'astro';

const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const voyages = await getCollection('voyages');
  return voyages
    .filter((voyage) => !voyage.data.draft)
    .map((voyage) => ({
    params: { id: voyage.slug },
    props: { voyage }
  }));
}

interface Props {
  voyage: any;
}

const { voyage } = Astro.props;

const { titre, description, duration, gpxFile, image, youtubeId } = voyage.data;
const gpxFileWithBase = withBase(gpxFile, base);
const distance = distanceFromGpx(gpxFile) ?? voyage.data.distance ?? 0;

const heroImageIsAsset = typeof image !== 'string';
const stageOneDistance = Math.ceil((distance * 0.52) / 10) * 10;
const stageTwoDistance = Math.max(0, distance - stageOneDistance);

const { Content } = await voyage.render();
---

<BaseLayout title={`${titre} | Biker Friends`}>
    <SiteHeader />

    <main class="bg-[#090c0b] text-tactical-text">
      <section class="relative min-h-[30vh] overflow-hidden border-b border-tactical-line bg-tactical-panel/50" style="aspect-ratio: 16/6">
        {heroImageIsAsset ? (
          <Image
            src={image as ImageMetadata}
            alt={titre}
            class="absolute inset-0 h-full w-full object-cover"
            loading="eager"
            decoding="sync"
            quality="high"
            widths={[800, 1200, 1600, 2000]}
            sizes="100vw"
            fetchpriority="high"
          />
        ) : (
          <picture>
            <source srcset={(image as unknown as string).replace(/\.(jpg|jpeg|png)$/i, '.webp')} type="image/webp" />
            <img
              src={image as unknown as string}
              alt={titre}
              class="absolute inset-0 h-full w-full object-cover"
              loading="eager"
              decoding="sync"
              fetchpriority="high"
            />
          </picture>
        )}
        <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(4,5,5,0.65)_0%,rgba(4,5,5,0.8)_52%,rgba(4,5,5,0.95)_100%)]"></div>

        <div class="relative mx-auto flex min-h-[30vh] max-w-7xl items-end px-4 pb-10 pt-16 sm:px-6 lg:px-8">
          <div class="grid w-full gap-8 lg:grid-cols-[1fr_340px] lg:items-end">
            <div>
              <a href={`${base}road-trips`} class="font-tech text-[11px] uppercase tracking-[0.2em] text-tactical-accent hover:text-tactical-accentSoft">
                ← Retour aux expéditions
              </a>
              <h1 class="mt-4 max-w-[12ch] font-display text-5xl uppercase leading-[0.9] sm:text-6xl">{titre}</h1>
              <p class="mt-5 max-w-2xl font-serif text-xl leading-8 text-zinc-200/90">{description}</p>
            </div>

            <aside class="border border-tactical-line bg-zinc-900/70 p-5 backdrop-blur-sm">
              <dl class="grid grid-cols-2 gap-x-5 gap-y-4">
                <div>
                  <dt class="font-tech text-[10px] uppercase tracking-[0.18em] text-tactical-muted">Distance totale</dt>
                  <dd class="mt-1 font-display text-4xl leading-none text-tactical-text">{distance.toLocaleString()} km</dd>
                </div>
                <div>
                  <dt class="font-tech text-[10px] uppercase tracking-[0.18em] text-tactical-muted">Durée</dt>
                  <dd class="mt-1 font-display text-4xl leading-none text-tactical-text">{duration}<span class="ml-1 font-tech text-xs uppercase tracking-[0.14em] text-tactical-muted">jours</span></dd>
                </div>
              </dl>

              <div class="mt-5 flex flex-wrap gap-3">
                <a
                  href={gpxFileWithBase}
                  download
                  class="inline-flex items-center gap-2 bg-tactical-accent px-4 py-3 font-tech text-[11px] uppercase tracking-[0.16em] text-[#071014] transition-colors hover:bg-tactical-accentSoft"
                >
                  Télécharger la trace GPX
                </a>
                {youtubeId && (
                  <a
                    href={`https://www.youtube.com/watch?v=${youtubeId}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 border border-tactical-line bg-black/40 px-4 py-3 font-tech text-[11px] uppercase tracking-[0.16em] text-tactical-text transition-colors hover:border-red-500/70 hover:text-red-300"
                     >
                      <svg viewBox="0 0 24 24" class="h-4 w-4 text-red-500" fill="currentColor" aria-hidden="true">
                        <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1C24 15.9 24 12 24 12s0-3.9-.5-5.8zM9.7 15.5V8.5l6.3 3.5-6.3 3.5z"/>
                      </svg>
                      Vidéo YouTube
                  </a>
                )}
              </div>
            </aside>
          </div>
        </div>
      </section>

      <section class="mx-auto grid max-w-7xl gap-8 px-4 py-10 sm:px-6 lg:grid-cols-[300px_1fr] lg:px-8">
        <aside class="h-fit border border-tactical-line bg-tactical-panel p-3">
          <GpxMap fileUrl={gpxFileWithBase} heightClass="h-[500px]" />
        </aside>

        <div class="space-y-8">
          <article class="border border-tactical-line bg-tactical-panel p-5 sm:p-6">
            <p class="font-serif text-xl leading-9 text-zinc-100/95">{description}</p>
            <div class="prose prose-invert mt-6 max-w-none font-tech text-sm leading-7 text-tactical-muted">
              <Content />
            </div>
          </article>

          <article class="border border-tactical-line bg-tactical-panel">
            <header class="flex flex-wrap items-end justify-between gap-4 border-b border-tactical-line bg-white/6 px-4 py-3 sm:px-5">
              <h2 class="font-display text-4xl uppercase leading-none">Étape 01</h2>
              <p class="font-tech text-[11px] uppercase tracking-[0.16em] text-tactical-muted">Distance <span class="text-tactical-accent">{stageOneDistance.toLocaleString()} km</span></p>
            </header>
            <div class="grid gap-0 border-b border-tactical-line md:grid-cols-[1.1fr_1fr]">
              <div style="aspect-ratio: 4/3" class="overflow-hidden">
                {heroImageIsAsset ? (
                  <Image
                    src={image as ImageMetadata}
                    alt="Stage 01"
                    class="h-full w-full object-cover"
                    loading="lazy"
                    decoding="async"
                    quality="high"
                    widths={[400, 600, 800]}
                    sizes="(max-width: 640px) 100vw, 50vw"
                  />
                ) : (
                  <picture>
                    <source srcset={(image as unknown as string).replace(/\.(jpg|jpeg|png)$/i, '.webp')} type="image/webp" />
                    <img
                      src={image as unknown as string}
                      alt="Stage 01"
                      class="h-full w-full object-cover"
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                )}
              </div>
              <div class="p-5">
                <h3 class="font-display text-3xl uppercase">La Muraille</h3>
                <p class="mt-3 font-tech text-sm leading-7 text-tactical-muted">
                 Départ tôt pour la première ascension et les connecteurs techniques. Roulez léger, gardez une marge de carburant et attendez-vous à des changements météorologiques rapides tout au long de la journée.
                </p>
              </div>
            </div>
            <footer class="flex items-center justify-between px-4 py-3 sm:px-5">
              <span class="border border-tactical-line px-2 py-1 font-tech text-[10px] uppercase tracking-[0.16em] text-tactical-muted">Piste facile/modérée</span>
              <a href={gpxFileWithBase} download class="font-tech text-[11px] uppercase tracking-[0.16em] text-tactical-text hover:text-tactical-accent">Télécharger GPX Jour 1</a>
            </footer>
          </article>

          <article class="border border-tactical-line bg-tactical-panel">
            <header class="flex flex-wrap items-end justify-between gap-4 border-b border-tactical-line bg-white/6 px-4 py-3 sm:px-5">
              <h2 class="font-display text-4xl uppercase leading-none">Étape 02</h2>
              <p class="font-tech text-[11px] uppercase tracking-[0.16em] text-tactical-muted">Distance <span class="text-tactical-accent">{stageTwoDistance.toLocaleString()} km</span></p>
            </header>
            <div class="grid gap-0 border-b border-tactical-line md:grid-cols-[1fr_1fr]">
              <div class="p-5">
                <h3 class="font-display text-3xl uppercase">La Route des Contrebandiers</h3>
                <p class="mt-3 font-tech text-sm leading-7 text-tactical-muted">
                  Le deuxième bloc s'enfonce davantage dans des terrains isolés. Gardez vos choix de ligne propres, préservez l'élan et économisez de l'énergie pour les sections de récupération en fin de journée.
                </p>
              </div>
              <div class="m-5 border border-tactical-line bg-black/25"></div>
            </div>
            <footer class="flex items-center justify-between px-4 py-3 sm:px-5">
              <span class="border border-red-400/40 bg-red-400/10 px-2 py-1 font-tech text-[10px] uppercase tracking-[0.16em] text-red-300">Alerte technique</span>
              <a href={gpxFileWithBase} download class="font-tech text-[11px] uppercase tracking-[0.16em] text-tactical-text hover:text-tactical-accent">Télécharger GPX Jour 2</a>
            </footer>
          </article>
        </div>
      </section>
    </main>
</BaseLayout>
