---
import '../../styles/global.css';
import { getCollection } from 'astro:content';
import CardVoyage from '../../components/CardVoyage.astro';
import GpxMap from '../../components/GpxMap.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { distanceFromGpx } from '../../utils/gpxDistance';

export async function getStaticPaths() {
  const voyages = await getCollection('voyages');
  return voyages.map((voyage) => ({
    params: { id: voyage.slug },
    props: { voyage }
  }));
}

interface Props {
  voyage: any;
}

const { voyage } = Astro.props;

const { titre, description, duration, gpxFile, image, youtubeId } = voyage.data;
const distance = distanceFromGpx(gpxFile) ?? voyage.data.distance ?? 0;

const voyageCountries: Record<string, string> = {
  'trans-pyrenean-adventure': 'Europe',
  'carretera-austral': 'Patagonie',
  'dalton-highway': 'Alaska'
};

const heroImage = image;
const country = voyageCountries[voyage.id] || 'Unknown';

const { Content } = await voyage.render();
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{titre} | Biker Friends</title>
  </head>
  <body>
    <SiteHeader />

    <main class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
      <a href="/road-trips" class="font-tech text-xs uppercase tracking-[0.18em] text-tactical-accent hover:text-tactical-accentSoft">
        ← Back to Expeditions
      </a>

      <section class="mt-8 grid gap-8 lg:grid-cols-[1.1fr_1fr]">
        <CardVoyage
          image={heroImage}
          title={titre}
          country={country}
          duration={duration}
          distance={distance}
          gpxUrl={gpxFile}
        />

        <article class="border border-tactical-line bg-tactical-panel p-4 sm:p-5">
          <h2 class="font-display text-3xl text-tactical-text">Trace GPX</h2>
          <p class="mt-2 font-tech text-xs uppercase tracking-[0.2em] text-tactical-muted">
            {distance.toLocaleString()} km | {duration} jours
          </p>
          <div class="mt-5">
            <GpxMap fileUrl={gpxFile} heightClass="h-[360px]" />
          </div>
        </article>
      </section>

      <article class="prose prose-invert mt-12 max-w-none rounded border border-tactical-line bg-tactical-panel p-6 font-tech text-sm leading-7 text-tactical-muted">
        <Content />
        {youtubeId && (
            <a
              href={`https://www.youtube.com/watch?v=${youtubeId}`}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 inline-flex items-center gap-2 border border-tactical-line bg-tactical-panelSoft px-4 py-2.5 font-tech text-[11px] uppercase tracking-[0.16em] text-tactical-muted transition-colors hover:border-tactical-accent hover:text-tactical-accent"
            >
              <svg viewBox="0 0 24 24" class="h-4 w-4 text-red-500" fill="currentColor" aria-hidden="true">
                <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1C24 15.9 24 12 24 12s0-3.9-.5-5.8zM9.7 15.5V8.5l6.3 3.5-6.3 3.5z"/>
              </svg>
              Voir la vidéo
            </a>
          )}
      </article>
    </main>
  </body>
</html>
