---
import '../styles/global.css';
import { INLINE_INIT_SCRIPT } from '../scripts/theme';

interface Props {
  title: string;
  lang?: string;
  bodyClass?: string;
  bodyAttrs?: Record<string, string>;
}

const {
  title,
  lang = 'fr',
  bodyClass,
  bodyAttrs = {}
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline set:html={INLINE_INIT_SCRIPT}></script>
    <slot name="head" />
  </head>
  <body class={bodyClass} {...bodyAttrs}>
    <slot />
    <script defer src="https://cloud.umami.is/script.js" data-website-id="87ed4d25-0826-4229-920c-77e117cac377"></script>
  </body>
</html>
