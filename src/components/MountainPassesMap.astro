---
import type { MountainPass } from '../utils/mountainPasses';

interface Props {
  passes: MountainPass[];
}

const { passes } = Astro.props;

// Calculate bounds for all passes
const coordinates = passes.filter(p => p.coordinates).map(p => p.coordinates!);
const avgLat = coordinates.length > 0 ? coordinates.reduce((sum, [lat]) => sum + lat, 0) / coordinates.length : 45.5;
const avgLng = coordinates.length > 0 ? coordinates.reduce((sum, [, lng]) => sum + lng, 0) / coordinates.length : 6.0;
---

<div id="mountain-passes-map" class="w-full h-[48rem] rounded-lg border border-tactical-line overflow-hidden bg-tactical-panel">
  <!-- Map will be rendered here by Leaflet -->
</div>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  const passesData = JSON.parse(document.currentScript!.dataset.passes || '[]');
  const mapElement = document.getElementById('mountain-passes-map');

  (async () => {
    if (!mapElement || !passesData.length) return;

    // Preload map_marker SVG to recolor it
    let mapMarkerSvg: string | null = null;
    try {
      const resp = await fetch( import.meta.env.BASE_URL + '/images/map_marker.svg');
      if (resp.ok) {
        console.log('Successfully loaded map marker SVG for inlining');
        mapMarkerSvg = await resp.text();
      }
    } catch (e) {
      // ignore
      console.warn('Failed to load map marker SVG, falling back to image:', e);
      mapMarkerSvg = null;
    }

    // Initialize map centered on Savoie region
    const map = L.map(mapElement).setView([45.5, 6.0], 8);

    // Add OpenStreetMap tiles with dark mode friendly styling
    const tileLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap contributors',
      maxZoom: 19
    });
    tileLayer.addTo(map);

    // Status colors
    const statusColors = {
      'OPEN': '#00A3C4',
      'CLOSED': '#EF4444',
      'ALERT': '#F59E0B',
      'PARTIAL': '#F59E0B'
    };

    // Add markers for each pass
    for (const pass of passesData) {
      if (!pass.coordinates) continue;
      const [lat, lng] = pass.coordinates;
      const color = statusColors[pass.status] || '#8b949e';

      // Always use the map marker SVG when possible (recolor per status), otherwise fallback to base-aware image
      let markerHtml = '';
      if (mapMarkerSvg) {
        const colored = mapMarkerSvg.replace(/fill=\"[^\"]*\"/g, `fill=\"${color}\"`).replace(/<svg/, '<svg style=\"width:26px;height:26px;\">');
        markerHtml = `<div style=\"display:flex;align-items:center;justify-content:center;width:32px;height:32px;\">${colored}</div>`;
      } else {
        markerHtml = '<div style="display:flex;align-items:center;justify-content:center;width:32px;height:32px;">' +
          '<img src="' + import.meta.env.BASE_URL + 'images/map_marker.svg" alt="marker" style="width:26px;height:26px;display:block;filter:drop-shadow(0 2px 4px rgba(0,0,0,0.35));" />' +
          '</div>';
      }

      const marker = L.marker([lat, lng], {
        icon: L.divIcon({
          html: markerHtml,
          iconSize: [32, 32],
          className: 'leaflet-marker'
        })
      });

      marker.bindPopup(`
        <div class="text-sm font-tech">
          <p class="font-semibold">${pass.name}</p>
          <p class="text-xs text-gray-500">${pass.altitude}m</p>
          <p class="text-xs font-bold" style="color: ${color}">${pass.status}</p>
        </div>
      `);

      marker.addTo(map);
    }

    // Fit map to markers bounds if available
    if (coordinates.length > 0) {
      const bounds = L.latLngBounds(
        coordinates.map(([lat, lng]) => [lat, lng])
      );
      map.fitBounds(bounds, { padding: [50, 50] });
    }
  })();
</script>

<style is:global>
  .leaflet-marker {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .leaflet-open-marker {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .leaflet-open-marker img {
    display: block;
    width: 26px;
    height: 26px;
    object-fit: contain;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.35));
  }
  .leaflet-open-marker svg {
    width: 26px;
    height: 26px;
  }
</style>
