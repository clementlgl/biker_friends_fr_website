---
import ThemeToggle from './ThemeToggle.astro'

const base = import.meta.env.BASE_URL

const navItems = [
  { label: 'Accueil', href: base },
  { label: 'Road Trips', href: `${base}road-trips` },
  { label: 'Matériel', href: `${base}gear` },
  { label: 'Cols', href: `${base}mountain-passes` },
  { label: 'Contact', href: `${base}contact` },
]
---

<header
  class="sticky top-0 z-50 border-b border-tactical-line bg-tactical-bg/92 backdrop-blur-sm transition-colors"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-3 sm:px-6 lg:px-8">
    <nav aria-label="Primary" class="flex items-center gap-1 sm:gap-5">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="font-display text-[11px] sm:text-base uppercase tracking-[0.06em] sm:tracking-[0.1em] text-tactical-muted transition-colors px-1.5 sm:px-3 py-2 rounded-sm hover:text-tactical-accent whitespace-nowrap"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2 sm:gap-4 shrink-0">
      <ThemeToggle />

      <a
        href="https://www.youtube.com/@biker_friends_fr"
        target="_blank"
        rel="noopener noreferrer"
        class="grid h-8 w-8 place-items-center border border-tactical-line light:bg-tactical-line/40 transition-colors hover:bg-tactical-panel/60 hover:border-tactical-accent"
        title="Visitez notre chaîne YouTube"
      >
        <svg
          class="h-4 w-4 text-[#FF0000]"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  // Highlight active nav link: underline + tactical accent color
  document.addEventListener('DOMContentLoaded', () => {
    try {
      const links = document.querySelectorAll('header nav a')
      const loc = window.location.href
      function normalize(url) {
        try {
          return new URL(url, window.location.origin).pathname.replace(/\/$/, '') || '/'
        } catch (e) {
          return url
        }
      }
      const current = normalize(loc)
      links.forEach((a) => {
        const href = a.getAttribute('href') || ''
        const target = normalize(href)
        if (target === current || (target === '' && current === '/')) {
          a.classList.remove('text-tactical-muted')
          a.classList.add(
            'text-tactical-accent',
            'underline',
            'decoration-2',
            'decoration-tactical-accent'
          )
          a.setAttribute('aria-current', 'page')
        } else {
          a.removeAttribute('aria-current')
        }
      })
    } catch (e) {
      /* noop */
    }
  })
</script>
