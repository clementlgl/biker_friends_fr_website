---
/**
 * ResponsiveImage - Composant pour images optimisées avec Astro
 * Supporte les images depuis public/ et src/assets/
 * Génère automatiquement WebP au build
 */

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  src: string | ImageMetadata;
  alt: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  decoding?: 'async' | 'sync' | 'auto';
  quality?: 'low' | 'mid' | 'high';
  widths?: number[];
  sizes?: string;
  fetchpriority?: 'high' | 'low' | 'auto';
  aspectRatio?: string;
}

const {
  src,
  alt,
  class: className,
  loading = 'lazy',
  decoding = 'async',
  quality = 'high',
  widths = [400, 600, 800],
  sizes = '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw',
  fetchpriority = 'auto',
  aspectRatio
} = Astro.props;

// Déterminer le format basé sur le type de source
const isAsset = typeof src !== 'string';
const format = isAsset ? 'webp' : undefined;

// Déterminer la qualité
const qualityMap = { low: 60, mid: 75, high: 85 };
const imageQuality = qualityMap[quality];
---

{isAsset ? (
  <figure
    class={`overflow-hidden ${className || ''}`}
    style={aspectRatio ? `aspect-ratio: ${aspectRatio}` : undefined}
  >
    <Image
      src={src}
      alt={alt}
      class="h-full w-full object-cover"
      loading={loading}
      decoding={decoding}
      quality={imageQuality}
      format={format}
      widths={widths}
      sizes={sizes}
      fetchpriority={fetchpriority}
    />
  </figure>
) : (
  // Fallback pour les images publiques avec support WebP
  <figure
    class={`overflow-hidden ${className || ''}`}
    style={aspectRatio ? `aspect-ratio: ${aspectRatio}` : undefined}
  >
    <picture>
      <!-- Source WebP pour les navigateurs modernes -->
      <source
        srcset={src.replace(/\.(jpg|jpeg|png)$/i, '.webp')}
        type="image/webp"
      />
      <!-- Source AVIF pour les navigateurs très modernes -->
      <source
        srcset={src.replace(/\.(jpg|jpeg|png)$/i, '.avif')}
        type="image/avif"
      />
      <!-- Fallback JPEG/PNG -->
      <img
        src={src}
        alt={alt}
        class="h-full w-full object-cover"
        loading={loading}
        decoding={decoding}
        fetchpriority={fetchpriority}
      />
    </picture>
  </figure>
)}
