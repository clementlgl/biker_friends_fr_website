---
/**
 * Composant OptimizedImage
 * Convertit automatiquement les images en WebP avec fallback
 */

export interface Props {
  src: string;
  alt: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  decoding?: 'async' | 'sync';
  widths?: number[];
  sizes?: string;
  fetchpriority?: 'high' | 'low' | 'auto';
}

const {
  src,
  alt,
  class: className,
  loading = 'lazy',
  decoding = 'async',
  widths = [400, 600, 800],
  sizes = '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw',
  fetchpriority = 'auto'
} = Astro.props;

// Convertir le chemin en WebP
function getWebPPath(imagePath: string): string {
  // Remplacer l'extension par .webp
  return imagePath.replace(/\.(jpg|jpeg|png)$/i, '.webp');
}

const webpSrc = getWebPPath(src);
const fallbackSrc = src;
---

<picture>
  <!-- Source WebP pour les navigateurs modernes -->
  <source
    srcset={webpSrc}
    type="image/webp"
  />
  <!-- Fallback pour les navigateurs qui ne supportent pas WebP -->
  <img
    src={fallbackSrc}
    alt={alt}
    class={className}
    loading={loading}
    decoding={decoding}
    fetchpriority={fetchpriority}
  />
</picture>
